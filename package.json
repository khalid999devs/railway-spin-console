{
  "name": "railway-spin-console",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "dev:fake": "RAILWAY_FAKE=1 next dev",
    "build": "next build",
    "preview": "cp -R .next/static .next/standalone/.next/static && node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:bundle": "node scripts/check-bundle.mts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:bundle",
    "e2e": "playwright test",
    "probe": "node scripts/probe.mts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "graphql": "^17.0.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
